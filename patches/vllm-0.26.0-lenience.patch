 from vllm.triton_utils import tl, tldevice, triton
 from vllm.v1.worker.gpu.sample.gumbel import gumbel_block_argmax, tl_rand32
 
+# LOSSY-VERIFICATION PILOT PATCH (not upstream vLLM).
+#
+# Lenience relaxation of the acceptance rule by a factor lam in (0, 1]:
+#     strict   accept iff  p(x)/q(x)        > u
+#     lenient  accept iff  p(x)/(lam*q(x))  > u
+#
+# The kernel already works in log space, so this is one additive term:
+#     log p > log u + log q + log(lam)
+# log(lam) <= 0, so a smaller factor lowers the bar and accepts more draft
+# tokens. lam == 1.0 gives log(lam) == 0.0 exactly, and `x > y + 0.0` is
+# bit-identical to `x > y` in IEEE754, so the strict control arm is unaffected
+# by this expression (the kernel is still recompiled with an extra argument,
+# so equivalence of the whole run is an empirical claim, not a proof).
+#
+# Naming: the knob is the lenience FACTOR (lam), not beta. In the mentored-
+# decoding notation of Xia et al. it is 1 - alpha; their beta is a different
+# parameter that they fix at 1, so calling this one beta misidentifies it.
+#
+# The factor is read from a FILE, not an environment variable. vLLM spawns its
+# EngineCore worker with a sanitised environment: the env var was verified
+# present in the API server's /proc/<pid>/environ and absent from EngineCore's,
+# so any env-var channel silently leaves the factor at 1.0 and the lossy arm
+# becomes an unlabelled copy of the strict arm. That failure produced two bogus
+# datasets before it was caught, so the value is logged loudly at import.
+#
+# The path is uid-scoped under /tmp, not repo-relative: a hardcoded clone path
+# desynchronises the writer (run_server_vllm.sh) from this reader as soon as
+# someone clones to a different directory, and the failure is silent.
+_LENIENCE_FACTOR_FILE = f"/tmp/lossy-spec-decode-lenience-{os.getuid()}"
+try:
+    with open(_LENIENCE_FACTOR_FILE) as _f:
+        _LENIENCE_FACTOR = float(_f.read().strip())
+    _LENIENCE_FACTOR_SOURCE = _LENIENCE_FACTOR_FILE
+except (OSError, ValueError):
+    _LENIENCE_FACTOR = 1.0
+    _LENIENCE_FACTOR_SOURCE = f"default, no readable {_LENIENCE_FACTOR_FILE}"
+if not 0.0 < _LENIENCE_FACTOR <= 1.0:
+    raise ValueError(f"lenience factor must be in (0, 1]; got {_LENIENCE_FACTOR}")
+_LENIENCE_LOG_FACTOR = math.log(_LENIENCE_FACTOR)
+# stderr, not stdout: run_server_vllm.sh probes this module by capturing
+# stdout, and an extra line there breaks the check.
+print(
+    f"[LENIENCE PATCH] pid={os.getpid()} lenience_factor={_LENIENCE_FACTOR} "
+    f"log_factor={_LENIENCE_LOG_FACTOR} ({_LENIENCE_FACTOR_SOURCE})",
+    file=sys.stderr,
+    flush=True,
+)
